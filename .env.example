# ======== الداتابيز (Postgres على Neon) ========
# سيبه فاضي = المشروع بيشتغل بمخزن الذاكرة (زيرو إعداد — dev واختبارات وعرض للعميل).
# حطّه = كل الحجوزات/الاشتراكات/المدفوعات بتتخزن في Postgres عبر Drizzle.
# الشكل من لوحة Neon → Connection string (Pooled):
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Vercel + Neon integration بيحط POSTGRES_URL لوحده — المشروع بيقراه لو DATABASE_URL فاضي
# POSTGRES_URL=

# بعد ما تحطه:  npm run db:migrate    (بينشئ الجداول التلاتة من مجلد drizzle/)

# ======== الوصلة بالباك إند ========
# بروكسي لكل نداءات /api/* للباك إند (الأفضل — من غير CORS)
# اسيبه فاضي عشان تستخدم وضع التجربة المحلي
BACKEND_URL=

# اختياري: البروكسي للمسارات دي بس (والباقي يفضل محلي)
# BACKEND_ONLY=bookings,subscribe,pay

# أو نداءات مباشرة من المتصفح للباك إند (محتاج CORS عندك)
# NEXT_PUBLIC_API_BASE=https://api.your-gym.com

# ======== بوابة الدفع ========
# sandbox = محاكاة بسلوك بنك حقيقي (Luhn + رفض + 3DS)
NEXT_PUBLIC_PAYMENT_PROVIDER=sandbox
# NEXT_PUBLIC_PAYMENT_SECRET=          # مفتاح البوابة الحقيقية (سيرفر-سايد بس)

# ======== لوحة الإدارة (/admin) ========
# في التطوير لو سيبته فاضي: الباسورد الافتراضي admin123
# في الإنتاج لازم تحطه — من غيره اللوحة بتتقفل خالص (503)
ADMIN_PASSWORD=
# اختياري: مفتاح توقيع كوكي الجلسة (لو فاضي بيتشتق من الباسورد) — أي نص عشوائي طويل
# ADMIN_SECRET=

# ======== SEO ========
NEXT_PUBLIC_SITE_URL=https://fitzone.pro
