# ======== الوصلة بالباك إند ========
# بروكسي لكل نداءات /api/* للباك إند (الأفضل — من غير CORS)
# اسيبه فاضي عشان تستخدم وضع التجربة المحلي
BACKEND_URL=

# اختياري: البروكسي للمسارات دي بس (والباقي يفضل محلي)
# BACKEND_ONLY=bookings,subscribe,pay

# أو نداءات مباشرة من المتصفح للباك إند (محتاج CORS عندك)
# NEXT_PUBLIC_API_BASE=https://api.your-gym.com

# ======== بوابة الدفع ========
# sandbox = محاكاة بسلوك بنك حقيقي (Luhn + رفض + 3DS)
NEXT_PUBLIC_PAYMENT_PROVIDER=sandbox
# NEXT_PUBLIC_PAYMENT_SECRET=          # مفتاح البوابة الحقيقية (سيرفر-سايد بس)

# ======== SEO ========
NEXT_PUBLIC_SITE_URL=https://fitzone.pro
