# ======== الداتابيز (Postgres — Supabase أو Neon أو أي بوستجرس) ========
# سيبه فاضي = المشروع بيشتغل بمخزن الذاكرة (زيرو إعداد — dev واختبارات وعرض للعميل).
# حطّه = كل الحجوزات/الاشتراكات/المدفوعات بتتخزن في Postgres عبر Drizzle.
# الدرايفر بيتحدد أوتوماتيك من الـ URL: Neon → HTTP driver · أي حاجة تانية → postgres.js (TCP+TLS)
#
# Supabase → Dashboard ← Connect ← ORMs/Drizzle:
#   • التشغيل (الأنسب للـ serverless) — Transaction pooler، بورت 6543:
#     DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
#   • المايجريشن — Session pooler (نفس الـ host بورت 5432) أو الوصلة المباشرة
#
# Neon → Dashboard ← Connection string (Pooled):
#     DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Vercel + Neon/Supabase integration بيحط POSTGRES_URL لوحده — المشروع بيقراه لو DATABASE_URL فاضي
# POSTGRES_URL=
# اختياري: جبر الدرايفر بدل الاكتشاف التلقائي — neon | postgres
# DATABASE_DRIVER=

# بعد ما تحطه:
#   npm run db:migrate   → بينشئ الجداول التلاتة من مجلد drizzle/  (على Supabase استخدم بورت 5432)
#   npm run db:check     → دكتور: الاتصال + الجداول + عدد الصفوف، وبيشرح أي خطأ بالعربي
#   npm run db:seed      → بيانات ديمو لآخر ٧ أيام عشان /admin ما تبقاش فاضية
# دليل Supabase خطوة بخطوة: docs/SUPABASE-SETUP.md

# ======== الوصلة بالباك إند ========
# بروكسي لكل نداءات /api/* للباك إند (الأفضل — من غير CORS)
# اسيبه فاضي عشان تستخدم وضع التجربة المحلي
BACKEND_URL=

# اختياري: البروكسي للمسارات دي بس (والباقي يفضل محلي)
# BACKEND_ONLY=bookings,subscribe,pay

# أو نداءات مباشرة من المتصفح للباك إند (محتاج CORS عندك)
# NEXT_PUBLIC_API_BASE=https://api.your-gym.com

# ======== بوابة الدفع ========
# sandbox = محاكاة بسلوك بنك حقيقي (Luhn + رفض + 3DS)
NEXT_PUBLIC_PAYMENT_PROVIDER=sandbox
# NEXT_PUBLIC_PAYMENT_SECRET=          # مفتاح البوابة الحقيقية (سيرفر-سايد بس)

# ======== لوحة الإدارة (/admin) ========
# في التطوير لو سيبته فاضي: الباسورد الافتراضي admin123
# في الإنتاج لازم تحطه — من غيره اللوحة بتتقفل خالص (503)
ADMIN_PASSWORD=
# اختياري: مفتاح توقيع كوكي الجلسة (لو فاضي بيتشتق من الباسورد) — أي نص عشوائي طويل
# ADMIN_SECRET=

# ======== SEO ========
NEXT_PUBLIC_SITE_URL=https://fitzone.pro
