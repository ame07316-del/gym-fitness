# ======== قاعدة البيانات ========
# ملف SQLite (بيتعمل لوحده أول تشغيل). `:memory:` = قاعدة في الذاكرة (للاختبارات)
DATABASE_PATH=data/gym.db

# حساب المدير العام الأول (بيتزرع مرة واحدة عند أول تشغيل)
SEED_OWNER_EMAIL=owner@fitzone.pro
# في الإنتاج: لو سبته فاضي هيتولّد كلمة سر عشوائية وتتطبع في لوج السيرفر مرة واحدة
# SEED_OWNER_PASSWORD=

# بيانات وحسابات العرض (owner/manager/coach/reception بكلمات سر معروفة)
# 1 = شغّال (الافتراضي في التطوير) — لازم يكون 0 في الإنتاج
DEMO_SEED=1

# ======== الوصلة بالباك إند ========
# بروكسي لكل نداءات /api/* للباك إند (الأفضل — من غير CORS)
# اسيبه فاضي عشان تستخدم قاعدة البيانات المحلية
BACKEND_URL=

# اختياري: البروكسي للمسارات دي بس (والباقي يفضل محلي)
# BACKEND_ONLY=bookings,subscribe,pay

# أو نداءات مباشرة من المتصفح للباك إند (محتاج CORS عندك)
# NEXT_PUBLIC_API_BASE=https://api.your-gym.com

# ======== بوابة الدفع ========
# sandbox = محاكاة بسلوك بنك حقيقي (Luhn + رفض + 3DS)
NEXT_PUBLIC_PAYMENT_PROVIDER=sandbox
# ⚠️ مفتاح البوابة سيرفر-سايد بس — من غير بادئة NEXT_PUBLIC (اللي بيتبعت للمتصفح)
# PAYMENT_SECRET=
# PAYMENT_PROVIDER=paymob

# ======== SEO ========
NEXT_PUBLIC_SITE_URL=https://fitzone.pro
